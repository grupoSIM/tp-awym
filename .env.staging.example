# Configuración de Staging (Hostinger VPS)
# Copiar a .env en el directorio de staging en el VPS (/home/.../tp-awym-staging/.env)

# Base de datos MySQL
MYSQL_ROOT_PASSWORD=un_password_root_robusto_aqui
MYSQL_DATABASE=turnos_staging_db
MYSQL_USER=turnos_staging_user
MYSQL_PASSWORD=un_password_usuario_robusto_aqui

# Secretos de autenticación (generar cadenas aleatorias largas)
JWT_SECRET=reemplazar_por_un_jwt_secret_largo_y_seguro
COOKIE_SECRET=reemplazar_por_un_cookie_secret_largo_y_seguro

# Puerto expuesto en el host para el reverse proxy del VPS
STAGING_WEB_PORT=3080

# URL pública del subdominio de staging (ej. https://turnos-staging.tudominio.com)
CLIENT_URL=https://turnos-staging.tudominio.com

# Cargar usuarios de prueba al iniciar (true para poblar datos iniciales, luego false)
RUN_SEED=true
